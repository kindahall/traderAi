# Agent Trader AI - exemple de configuration locale
# Ne jamais committer de vraies clés API.

# Exchanges / trading
NEXT_PUBLIC_DEFAULT_TRADING_MODE=paper
EXCHANGE_PROVIDER=dydx
EXCHANGE_WALLET_PROVIDER=
EXCHANGE_API_KEY=
EXCHANGE_SECRET_KEY=
EXCHANGE_PASSPHRASE=
WITHDRAWALS_ENABLED=false
LIVE_TRADING_ENABLED=false
TRADERAI_API_TOKEN=

# Runtime paper local
# Laissez vide pour que l'API /api/paper-trading/runtime utilise l'origine courante.
PAPER_RUNTIME_BASE_URL=
PAPER_RUNTIME_INTERVAL_MS=30000
APP_DATA_CACHE_TTL_MS=10000

# OpenClaw Gateway / runtime externe
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_AUTH_MODE=token
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_PASSWORD=
OPENCLAW_DEFAULT_AGENT_ID=alpha-01
OPENCLAW_REQUEST_TIMEOUT_MS=5000
OPENCLAW_ALLOW_REMOTE_OVERRIDES=false

# Defaults LLM
DEFAULT_LLM_PROVIDER=openai
DEFAULT_REASONING_MODEL=gpt-5.2
DEFAULT_FAST_MODEL=gpt-5-mini
DEFAULT_AUDIT_MODEL=claude-opus
DEFAULT_FALLBACK_MODEL=mistral-large
CUSTOM_GPT55_MODEL_ID=gpt-5.5-thinking

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# Mistral
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# xAI
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-pro

# Alibaba Qwen / DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
QWEN_API_KEY=
QWEN_DEFAULT_MODEL=qwen-plus

# Moonshot / Kimi
MOONSHOT_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_DEFAULT_MODEL=kimi-k2.6

# MiniMax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_DEFAULT_MODEL=MiniMax-M2.7

# Tencent Hunyuan
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_HUNYUAN_API_KEY=
TENCENT_HUNYUAN_REGION=
TENCENT_HUNYUAN_MODEL=hy3-preview

# Baidu ERNIE / Wenxin
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_ERNIE_API_KEY=
BAIDU_DEFAULT_MODEL=ernie-4.5

# Zhipu / GLM / Z.ai
ZHIPU_API_KEY=
ZAI_API_KEY=
ZHIPU_BASE_URL=
ZHIPU_DEFAULT_MODEL=glm-5

# ByteDance Doubao / Volcano Engine
DOUBAO_API_KEY=
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=
DOUBAO_DEFAULT_MODEL=doubao-pro

# Naver HyperCLOVA X
NAVER_API_KEY=
NAVER_SECRET_KEY=
NAVER_CLOVA_API_KEY=
NAVER_BASE_URL=
NAVER_DEFAULT_MODEL=hyperclova-x

# Other Asian / custom providers
LG_EXAONE_API_KEY=
UPSTAGE_SOLAR_API_KEY=
RAKUTEN_AI_API_KEY=
SAKANA_AI_API_KEY=
HUAWEI_PANGU_API_KEY=
YI_API_KEY=
INTERNLM_API_KEY=
BAICHUAN_API_KEY=
STEPFUN_API_KEY=

# Custom OpenAI-compatible / router / local model
CUSTOM_LLM_PROVIDER=custom
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_FORMAT=openai-compatible

# Local Ollama provider (no API key required)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
LLM_GENERATION_TIMEOUT_MS=8000

# Market data public
MARKET_DATA_PROVIDER=dydx
MARKET_INSTRUMENT_TYPE=perp
MARKET_SYMBOLS=auto
MARKET_MAX_SYMBOLS=10
MARKET_QUOTE_ASSETS=USD
MARKET_REST_BASE_URL=https://indexer.dydx.trade
PRIMARY_MARKET_SYMBOL=BTC-USD
AUTHORIZED_PAIRS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,DOGE-USD,LINK-USD,OP-USD,PEPE-USD,WIF-USD,LTC-USD
NEXT_PUBLIC_MARKET_SYMBOLS=BTCUSD,ETHUSD,SOLUSD,XRPUSD,DOGEUSD,LINKUSD,OPUSD,PEPEUSD,WIFUSD,LTCUSD
NEXT_PUBLIC_MARKET_STREAM_URL=
NEXT_PUBLIC_CANDLE_STREAM_URL=
# Alternative custom stream format:
# NEXT_PUBLIC_MARKET_STREAM_URL=wss://example.com/stream?streams={streams}
# NEXT_PUBLIC_CANDLE_STREAM_URL=wss://example.com/ws/{stream}
# Binance public stream:
# NEXT_PUBLIC_MARKET_STREAM_URL=wss://stream.binance.com:9443/stream
# NEXT_PUBLIC_CANDLE_STREAM_URL=wss://stream.binance.com:9443/ws/{stream}

# LLM role overrides
LLM_PRINCIPAL_PROVIDER=
LLM_PRINCIPAL_MODEL=
LLM_PRINCIPAL_FALLBACK_MODEL=
LLM_RAPIDE_PROVIDER=
LLM_RAPIDE_MODEL=
LLM_RAPIDE_FALLBACK_MODEL=
LLM_AUDITEUR_PROVIDER=
LLM_AUDITEUR_MODEL=
LLM_AUDITEUR_FALLBACK_MODEL=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_FALLBACK_MODEL=
